"help.title" = "How it works";
"help.tutorial.reopen" = "Watch tutorial";
"help.nav.back" = "Back";
"help.nav.topics" = "All topics";
"help.nav.position" = "%lld of %lld";
"help.tutorial.playLesson.title" = "Play a lesson";
"help.tutorial.playLesson.caption" = "Follow the pattern. Each row is one pad.\nHit when the line reaches a block.\nTap Start and play after the count-in.";
"help.lesson.padRow" = "One row per pad";
"help.lesson.now" = "The line shows when to hit";
"help.lesson.countIn" = "Count-in";
"help.tutorial.hitColours.title" = "Hit colours";
"help.tutorial.hitColours.caption" = "Check the colour of each hit in the pattern band.\nUse the feedback to adjust your timing and pad choice.";
"help.hit.correct" = "Right pad, on time";
"help.hit.off" = "Right pad, off time";
"help.hit.wrong" = "Wrong pad or missed hit";
"help.tutorial.modes.title" = "Three ways to practise";
"help.tutorial.modes.caption" = "Listen: hear the pattern and join in. No stars.\nPlay: play the pattern yourself and earn stars. The metronome is optional.\nAfter me: listen to the app play a phrase, then repeat it. No stars.";
"help.tutorial.starsAndTempo.title" = "Stars and tempo";
"help.tutorial.starsAndTempo.caption" = "★ Pass the lesson.\n★★ Play cleanly at goal tempo. Clean passes in Play raise the tempo towards the goal.\n★★★ Pass two scheduled reviews from memory on different days.\nTap the stars for the lesson requirements. Tap the tempo field while stopped to change it.";
"help.tutorial.whereNext.title" = "Where to go next";
"help.tutorial.whereNext.caption" = "Start with Intro. Tap Rules there for the details.\nBrowse all lessons in Library.\nFind reviews in Training and follow Today when reviews are due.\nOpen the question mark in a lesson, or How it works on Home or in Settings.";
"help.lesson.title" = "The lesson screen";
"help.lesson.caption" = "1 Lesson info · 2 Legend for pad names · 3 Help\n4 More tools: bars, sound and loops. Practise a bar loop without earning stars.\n5 From memory · 6 Static or scrolling view. Tap Static again to cycle through bar counts.\n7 Tempo · 8 Star requirements · 9 Start, Stop and Restart";
"help.modes.title" = "Modes";
"help.modes.caption" = "Listen: hear the pattern and join in. Tempo stays fixed and you earn no stars.\nPlay: earn stars by playing the pattern. Use More tools to turn the metronome or pattern sound on or off.\nAfter me: hear a phrase, then repeat it. Your response gets a score, with no lesson stars.";
"help.signals.title" = "Colours and signals";
"help.signals.caption" = "Read the hit colours in the band. Listen uses a lighter band than Play.\nWatch the band deepen as the tempo approaches the goal. A glow on the right means you are early, on the left you are late.\nOpen Details after playing to see which bars were clean, early, late or uneven.\nUse the result controls to try again, play on or move to the next lesson when offered.";
"help.signals.behind" = "Late";
"help.signals.ahead" = "Early";
"help.stars.label" = "Star %lld: %@";
"help.stars.caption" = "★ Pass at %lld %% or higher. In Learning, accurate hits with few errors can also qualify at a lower score.\n★★ Play cleanly at goal tempo. ★★★ Pass two scheduled reviews on different days.\nTap the stars for the required passes. For the first two stars the app aims for at least 16 hits, with at most four passes. Intro needs at least three passes for ★★.\nChoose Learning to add up good passes or Challenge to require them in a row. Play stops when you earn ★★ or ★★★.";
"help.tempo.tap" = "Tap the tempo field while stopped";
"help.tempo.caption" = "Adjust by −5, −1, +1 or +5 BPM, or return to Starting tempo. The lesson remembers your tempo.\nIn Play, clean passes raise the tempo up to the goal. Set the automatic step to 1, 2, 5 or 10 BPM in Settings.\nPlay with no errors in Intro. Elsewhere, a clean pass allows no errors through 15 hits, one through 32, and two above that.";
"help.memory.caption" = "While stopped, tap the crossed-out eye, then Start.\nUse “%@” in Settings to show the first pass, fade the second and hide the pattern from the third. Turn it off to hide the pattern right after the count-in.\nPractise from memory to prepare for reviews. Stars for this option come only from a successful scheduled review.";
"help.memory.shown" = "Pass 1 · pattern visible";
"help.memory.fading" = "Pass 2 · pattern fades";
"help.memory.hiddenFromThird" = "Pass 3 onward · pattern hidden";
"help.memory.hidden" = "Pattern hidden after the count-in";
"help.reviews.timeline" = "★★ → +%lld → +%lld → +%lld → +%lld days → %@";
"help.reviews.warmups" = "Notes hide after 2 good passes in a row (80 %+).";
"help.reviews.twoPasses" = "Two qualifying passes in one review";
"help.reviews.caption" = "Open a due lesson from Home, Training or Library. It starts ready for From memory at goal tempo.\nPass two full hidden passes at goal tempo or faster, each at least %lld %%. Play then stops. The second successful review on a different day earns ★★★.\nAfter two failed eligible passes, the schedule goes back one step and the review returns tomorrow. The exclamation mark means you played but the review did not count.\nFollow the gaps above from ★★ to the fourth successful review. Turn on Review reminder in Settings if you want a reminder.";
"help.training.title" = "Today and Training";
"help.training.caption" = "Follow Today when reviews are due. It starts with up to two reviews, then adds a new lesson and a Mix when available. You can skip steps.\nOpen Training for the review queue, your memory overview and the next seven days. You can put off reviews until tomorrow.\nStart a Mix once at least two lessons have ★★. Play them back to back at their goal tempos or choose New mix.\nChoose Play after me to copy what the app plays, with the pattern hidden and no lesson stars.";
"help.library.stage" = "Locked stage";
"help.library.progress" = "Two-star lessons unlock stages";
"help.library.caption" = "Browse Path, Genres or Techniques. Search or filter by stars and progress. Use Show completed to include finished lessons.\nUnlock the next stage with ★★ in half the previous stage’s lessons, rounded up and capped at 10. On an 8-pad controller only compatible lessons count.\nTap a locked lesson to see the stage requirement. You can confirm a manual unlock and lock the stage again while it has no stars. Intro and extension lessons are always open.\nChoose the source for Next lesson in Settings.";
"help.controller.caption" = "Connect a MIDI controller by USB or Bluetooth. Open Controller and calibration in Settings.\nChoose an 8- or 16-pad profile, or use MIDI learn to map your pads. Check incoming hits in the MIDI monitor. Some lessons require 16 pads.\nUse the small pad layout to see which pad you hit. Map controller buttons to the actions above. Tempo buttons and the knob work while stopped.";
"help.keyboard.title" = "Touch and keyboard";
"help.keyboard.mapping" = "Pad rows from top to bottom: 1 2 3 4, Q W E R, A S D F, Z X C V";
"help.keyboard.caption" = "Turn on Touch pads in portrait in Settings, use a 16-pad profile and hold the iPad upright.\nConnect a hardware keyboard and turn on Play pads with keyboard in Settings. The four rows above match the pads from top to bottom.";
"help.setup.title" = "Sound, timing and backup";
"help.setup.caption" = "Choose Automatic for a kit suited to the lesson. Use More tools to choose a kit for just that lesson.\nAdjust metronome, pad and pattern volumes separately.\nRun Timing calibration for your input and audio output. Touch, keyboard and controller can each need their own calibration.\nIn Settings, under Progress, back up to a file. Restore from backup keeps the stronger lesson progress.";
"Instrument volumes" = "Instrument volumes";
"Reset instrument volumes" = "Reset instrument volumes";
"Fine-tune single instruments for all lessons and sound kits. 0 dB is the default." = "Fine-tune single instruments for all lessons and sound kits. 0 dB is the default.";

